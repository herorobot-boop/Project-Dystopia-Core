# evaluate_lora_gui.ipynb

import ipywidgets as widgets
import json
from IPython.display import display

# ロード
with open("lora_registry.json", "r") as f:
    registry = json.load(f)

# 選択肢
lora_names = list(registry.keys())
dropdown = widgets.Dropdown(options=lora_names, description='LoRA:')

# スライダー群
sliders = {
    "reproducibility": widgets.IntSlider(min=0, max=5, description="再現性"),
    "breakdown_resistance": widgets.IntSlider(min=0, max=5, description="破綻耐性"),
    "compatibility": widgets.IntSlider(min=0, max=5, description="汎用性"),
    "strength_control": widgets.IntSlider(min=0, max=5, description="強度制御"),
    "phase_v_ready": widgets.IntSlider(min=0, max=5, description="動画適合性")
}

notes = widgets.Textarea(description="備考", layout=widgets.Layout(width='80%', height='80px'))
save_button = widgets.Button(description="保存")

def save_scores(b):
    name = dropdown.value
    for key in sliders:
        registry[name]["score"][key] = sliders[key].value
    registry[name]["notes"] = notes.value
    with open("lora_registry.json", "w") as f:
        json.dump(registry, f, indent=2)
    print(f"✅ {name} の評価を保存しました。")

save_button.on_click(save_scores)

# 表示
display(dropdown)
for s in sliders.values():
    display(s)
display(notes, save_button)
