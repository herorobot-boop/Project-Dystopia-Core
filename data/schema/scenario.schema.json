{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "type": "object",
  "required": [
    "id", "title", "engine", "place", "tags",
    "cast", "wardrobe", "key_props", "beats", "verdicts", "prompt_seed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,48}$",
      "description": "engine_place_連番。半角小文字・数字・アンダースコアのみ"
    },
    "title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "engine": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "cast": {
      "type": "object",
      "required": ["female", "male"],
      "additionalProperties": false,
      "properties": {
        "female": { "type": "integer", "minimum": 1, "maximum": 3 },
        "male": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cast_note": { "type": "string", "maxLength": 200 }
      }
    },
    "wardrobe": {
      "type": "object",
      "required": ["female"],
      "additionalProperties": false,
      "properties": {
        "female": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": { "type": "string", "maxLength": 24 }
        },
        "male": {
          "type": "array", "maxItems": 6,
          "items": { "type": "string", "maxLength": 24 }
        }
      }
    },
    "key_props": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "type": "string", "maxLength": 30 }
    },
    "beats": {
      "type": "array", "minItems": 4, "maxItems": 12,
      "items": { "type": "string", "maxLength": 80 }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "V1": { "type": "string" },
        "V2": { "type": "string" },
        "V3": { "type": "string" },
        "V4": { "type": "string" }
      }
    },
    "prompt_seed": { "type": "string", "minLength": 20, "maxLength": 900 },
    "ng": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "maxLength": 24 }
    },
    "notes": { "type": "string", "maxLength": 400 }
  }
}
